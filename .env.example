# Copy this file to .env and fill in your values.
# cp .env.example .env

# Active provider (optional).
# Values: dashscope / anthropic / openai / xai
# When unset, TS server auto-detects in order: dashscope > anthropic > openai > xai
# ACTIVE_PROVIDER=dashscope

# DashScope / KeploreAI
DASHSCOPE_BASE_URL=https://physmind-proxy.marvin-gao-cs.workers.dev/v1
DASHSCOPE_API_KEY=your_dashscope_key_here
DASHSCOPE_MODEL=qwen-plus

# Anthropic — get yours at https://console.anthropic.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=your_ahthropic_key_here
ANTHROPIC_MODEL=claude-haiku-4-20250514

# OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o

# xAI
XAI_BASE_URL=https://api.x.ai/v1
XAI_API_KEY=your_xai_key_here
XAI_MODEL=grok-3
